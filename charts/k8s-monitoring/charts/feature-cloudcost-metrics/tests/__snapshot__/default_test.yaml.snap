        prometheus.relabel "staging" {
          max_cache_size = 100000
          rule {
            target_label = "instance"
            replacement = "staging"
          }
          rule {
            target_label = "job"
            replacement = "integrations/cloudcost-exporter-staging"
          }
          forward_to = argument.metrics_destinations.value
        } // prometheus.relabel "staging"
      } // declare "cloudcost_metrics"
